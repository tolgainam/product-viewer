{
  "name": "@tolgainam/product-viewer",
  "version": "0.2.0",
  "description": "Apple-style product viewer React component with expandable feature cards, colour variants and media galleries. Renders from a JSON content file. No UI framework dependency.",
  "author": "Tolga Inam <tolgainam@gmail.com>",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./model": {
      "types": "./dist/model.d.ts",
      "import": "./dist/model.js"
    },
    "./schema": "./schema/product-viewer.schema.json",
    "./examples/example-product.json": "./examples/example-product.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "schema",
    "examples/example-product.json",
    "examples/CREDITS.md",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "react",
    "product-viewer",
    "product-page",
    "framer-motion",
    "component"
  ],
  "homepage": "https://tolgainam.github.io/product-viewer",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tolgainam/product-viewer.git"
  },
  "bugs": {
    "url": "https://github.com/tolgainam/product-viewer/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "test": "vitest run",
    "verify:consumer": "node scripts/verify-consumer.mjs",
    "fetch:assets": "node scripts/fetch-demo-assets.mjs",
    "dev": "vite --config dev/vite.config.mts",
    "demo:build": "vite build --config dev/vite.config.pages.mts",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@react-three/drei": ">=9",
    "@react-three/fiber": ">=8",
    "framer-motion": "^12.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "three": ">=0.150.0"
  },
  "peerDependenciesMeta": {
    "@react-three/drei": {
      "optional": true
    },
    "@react-three/fiber": {
      "optional": true
    },
    "three": {
      "optional": true
    }
  },
  "devDependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.3",
    "ffmpeg-static": "^5.3.0",
    "framer-motion": "^12.29.2",
    "jsdom": "^28.0.0",
    "react": "~19.2.4",
    "react-dom": "~19.2.4",
    "sharp": "^0.34.5",
    "three": "^0.160.1",
    "typescript": "~5.6.2",
    "vite": "^5.4.10",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "lucide-react": "^1.47.0"
  }
}
